# Copy to .env, fill in, and export before running the scripts:
#   cp .env.example .env && set -a && source .env && set +a
# .env is ignored by git. Never commit API keys.

# ---- Data ---------------------------------------------------------------
# Directory holding the PRISM data files. Leave empty to use ./data
PRISM_DATA_DIR=

# ---- Evaluated models ---------------------------------------------------
# OpenAI-compatible endpoint used for most models (leave the base empty for api.openai.com)
PRISM_API_BASE=
PRISM_API_KEY=

# DeepSeek official API (DeepSeek-V3.2 and DeepSeek-R1)
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=

# Locally served model, e.g.
#   vllm serve /path/to/DeepSeek-R1-Distill-Qwen-32B --served-model-name DeepSeek-R1-Distill-Qwen-32B --port 8000
VLLM_API_BASE=http://localhost:8000/v1
VLLM_API_KEY=EMPTY
LOCAL_SERVED_MODEL=DeepSeek-R1-Distill-Qwen-32B

# Served model names, only needed when your provider uses other names than configs/models.yaml
# GPT_4O_MODEL=gpt-4o-2024-11-20
# GLM_4_MODEL=glm-4-flash

# ---- Judge (Appendix J: GPT-4o) -----------------------------------------
JUDGE_API_BASE=
JUDGE_API_KEY=
JUDGE_MODEL=gpt-4o-2024-11-20
